@{
    ViewData["Title"] = "HistorialVenta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>HistorialVenta</h1>

@section Estilos {
    <link href="~/vendor/jquery-ui/jquery-ui.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
}

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">Historial de Venta</h6>
    </div>
    <div class="card-body">
        <div class="form-row align-items-end">
            <div class="form-group col-sm-3">
                <label for="cboBuscarPor">Buscar por</label>
                <select class="form-control form-control-sm" id="cboBuscarPor">
                    <option value="fecha">Fechas</option>
                    <option value="numero">Numero Venta</option>
                </select>
            </div>
            <div class="form-group col-sm-3 busqueda-fecha">
                <label for="txtFechaInicio">Fecha Inicio</label>
                <input type="text" class="form-control form-control-sm" id="txtFechaInicio">
            </div>
            <div class="form-group col-sm-3 busqueda-fecha">
                <label for="txtFechaFin">Fecha Fin</label>
                <input type="text" class="form-control form-control-sm" id="txtFechaFin">
            </div>
            <div class="form-group col-sm-3 busqueda-venta">
                <label for="txtNumeroVenta">Numero Venta</label>
                <input type="text" class="form-control form-control-sm" id="txtNumeroVenta">
            </div>
            <div class="form-group col-sm-3">
                <button class="btn btn-success btn-block btn-sm" type="button" id="btnBuscar">
                    <i class="fas fa-search"></i> Buscar
                </button>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-sm-12">
                <table class="table table-sm table-striped" id="tbventa">
                    <thead>
                        <tr>
                            <th>Fecha Registro</th>
                            <th>Numero Venta</th>
                            <th>Tipo Documento</th>
                            <th>Documento Cliente</th>
                            <th>Nombre Cliente</th>
                            <th>Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ── Modal Detalle Venta ──────────────────────────────────────────────── -->
<div class="modal fade" id="modalData" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6>Detalle Venta</h6>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="form-row">
                                <div class="form-group col-sm-4">
                                    <label>Fecha Registro</label>
                                    <input type="text" class="form-control form-control-sm" id="txtFechaRegistro" disabled>
                                </div>
                                <div class="form-group col-sm-4">
                                    <label>Numero Venta</label>
                                    <input type="text" class="form-control form-control-sm" id="txtNumVenta" disabled>
                                </div>
                                <div class="form-group col-sm-4">
                                    <label>Usuario Registro</label>
                                    <input type="text" class="form-control form-control-sm" id="txtUsuarioRegistro" disabled>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-sm-4">
                                    <label>Tipo Documento</label>
                                    <input type="text" class="form-control form-control-sm" id="txtTipoDocumento" disabled>
                                </div>
                                <div class="form-group col-sm-4">
                                    <label>Documento Cliente</label>
                                    <input type="text" class="form-control form-control-sm" id="txtDocumentoCliente" disabled>
                                </div>
                                <div class="form-group col-sm-4">
                                    <label>Nombre Cliente</label>
                                    <input type="text" class="form-control form-control-sm" id="txtNombreCliente" disabled>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-sm-4">
                                    <label>Sub Total</label>
                                    <input type="text" class="form-control form-control-sm" id="txtSubTotal" disabled>
                                </div>
                                <div class="form-group col-sm-4">
                                    <label>IGV</label>
                                    <input type="text" class="form-control form-control-sm" id="txtIGV" disabled>
                                </div>
                                <div class="form-group col-sm-4">
                                    <label>Total</label>
                                    <input type="text" class="form-control form-control-sm" id="txtTotal" disabled>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <table id="tbProductos" class="table table-sm table-striped">
                                        <thead>
                                            <tr>
                                                <th>Producto</th>
                                                <th>Cantidad</th>
                                                <th>Precio</th>
                                                <th>Total</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <a href="#" class="btn btn-primary btn-sm" target="_blank" id="linkImprimir">Imprimir</a>
                <button class="btn btn-danger btn-sm" type="button" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Modal Solicitar Factura ─────────────────────────────────────────── -->
<div class="modal fade" id="modalFactura" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h6 class="font-weight-bold">Solicitar Factura</h6>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="txtIdVentaFactura">
                <div class="form-row">
                    <div class="form-group col-sm-6">
                        <label>Número de Venta</label>
                        <input type="text" class="form-control form-control-sm" id="txtNumVentaFactura" disabled>
                    </div>
                    <div class="form-group col-sm-6">
                        <label>Uso del CFDI</label>
                        <select class="form-control form-control-sm" id="cboUsoCFDI"></select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-sm-6">
                        <label>Régimen Fiscal</label>
                        <select class="form-control form-control-sm" id="cboRegimenFiscalFactura"></select>
                    </div>
                    <div class="form-group col-sm-6">
                        <label>Forma de Pago</label>
                        <select class="form-control form-control-sm" id="cboFormaPago"></select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-sm-4">
                        <label>Método de Pago</label>
                        <select class="form-control form-control-sm" id="cboMetodoPago"></select>
                    </div>
                    <div class="form-group col-sm-4">
                        <label>Tipo de Comprobante</label>
                        <select class="form-control form-control-sm" id="cboTipoComprobante"></select>
                    </div>
                    <div class="form-group col-sm-4">
                        <label>Código Postal</label>
                        <input type="text" class="form-control form-control-sm" id="txtCPFactura" maxlength="5" placeholder="64000">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-warning btn-sm font-weight-bold" type="button" id="btnEnviarFactura">
                    <i class="fas fa-file-invoice"></i> Solicitar Factura
                </button>
                <button class="btn btn-danger btn-sm" type="button" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Modal Ver XML CFDI ──────────────────────────────────────────────── -->
<div class="modal fade" id="modalXml" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h6 class="modal-title font-weight-bold">
                    <i class="fas fa-file-code"></i> XML del CFDI Timbrado
                    <span id="xmlNumVenta" class="ml-2 text-warning"></span>
                </h6>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body p-0">
                <pre id="xmlContent"
                     style="background:#1e1e1e; color:#d4d4d4; padding:1.5rem;
                margin:0; font-size:0.78rem; overflow-x:auto;
                white-space:pre; border:none; min-height:300px;">
                Cargando...</pre>
            </div>
            <div class="modal-footer">
                <a id="btnDescargarZip" href="#" class="btn btn-success btn-sm" download>
                    <i class="fas fa-file-archive"></i> Descargar ZIP
                </a>
                <a id="btnDescargarXml" href="#" class="btn btn-primary btn-sm" download>
                    <i class="fas fa-download"></i> Descargar XML
                </a>
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/vendor/jquery-ui/jquery-ui.js"></script>
    <script src="~/vendor/jquery-ui/idioma/datepicker-es.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/vistas/Historial_Venta.js"></script>
}

