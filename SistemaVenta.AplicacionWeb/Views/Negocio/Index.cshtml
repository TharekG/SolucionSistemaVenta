@{
    ViewData["Title"] = "Negocio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">Datos del Negocio</h6>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-12">
                <form>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-row">
                                <div class="form-group col-sm-6">
                                    <label>RFC</label>
                                    <input type="text" class="form-control form-control-sm input-validar"
                                           id="txtRfc" name="RFC" maxlength="13" placeholder="RFC del negocio">
                                </div>
                                <div class="form-group col-sm-6">
                                    <label>Razón Social</label>
                                    <input type="text" class="form-control form-control-sm input-validar"
                                           id="txtRazonSocial" name="Razon Social">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-sm-6">
                                    <label>Correo</label>
                                    <input type="email" class="form-control form-control-sm input-validar"
                                           id="txtCorreo" name="Correo">
                                </div>
                                <div class="form-group col-sm-6">
                                    <label>Dirección</label>
                                    <input type="text" class="form-control form-control-sm input-validar"
                                           id="txtDireccion" name="Direccion">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-sm-6">
                                    <label>Teléfono</label>
                                    <input type="text" class="form-control form-control-sm input-validar"
                                           id="txTelefono" name="Telefono">
                                </div>
                                <div class="form-group col-sm-6">
                                    <label>Código Postal</label>
                                    <input type="text" class="form-control form-control-sm input-validar"
                                           id="txtCodigoPostal" name="Codigo Postal" maxlength="5" placeholder="64000">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-sm-6">
                                    <label>Símbolo Moneda</label>
                                    <input type="text" class="form-control form-control-sm input-validar"
                                           id="txtSimboloMoneda" name="Simbolo Moneda">
                                </div>
                                <div class="form-group col-sm-6">
                                    <label>Régimen Fiscal</label>
                                    <select class="form-control form-control-sm" id="cboRegimenFiscal">
                                        <option value="">-- Selecciona --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="col-sm-12">
                                    <button class="btn btn-success btn-sm" type="button" id="btnGuardarCambios">
                                        Guardar Cambios
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="row">
                                <div class="col-sm-12">
                                    <img id="imgLogo" style="max-width:200px;" src="" class="rounded" alt="Logo">
                                </div>
                            </div>
                            <br />
                            <div class="form-group col-sm-6">
                                <label>Logo</label>
                                <input class="form-control-file" type="file" id="txtLogo" />
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/vistas/Negocio_Index.js"></script>
}